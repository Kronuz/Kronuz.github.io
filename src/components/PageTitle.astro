---
// Custom override of Starlight's PageTitle: renders the page <h1> with an optional category
// emoji just before the title (announcement / tutorial / note) and an optional `subtitle`
// line on its own row below. The edit links live in the footer (EditLink.astro), and the text-size
// toggle beside the theme selector (ThemeSelect.astro).
//
// A page that names its project (`project: <id>`) gets a kicker line above the title: a blog
// post shows "Project: <name>", any other page (a synced reference doc) a breadcrumb back to
// the project's hub. The name is plain text while the hub is an unbuilt draft.
import { resolveProjectLink } from "../lib/projects.mjs";

const route = Astro.locals.starlightRoute;
const { title, subtitle, category, project } = route.entry.data as {
	title: string;
	subtitle?: string;
	category?: string;
	project?: string;
};
const CATEGORY = {
	announcement: { emoji: "📣", label: "Announcement" },
	tutorial: { emoji: "🛠️", label: "Tutorial" },
	note: { emoji: "💡", label: "Note" },
} as const;
const cat = category ? CATEGORY[category as keyof typeof CATEGORY] : undefined;

const isBlogPost = Boolean(route.entry?.data?.date);

const projectLink = await resolveProjectLink(project);
---

<div class="kz-page-head">
	{projectLink && (
		<p class="kz-page-project">
			{isBlogPost && <span>Project: </span>}
			{projectLink.href ? <a href={projectLink.href}>{projectLink.name}</a> : <span>{projectLink.name}</span>}
			{!isBlogPost && <span aria-hidden="true"> › </span>}
			{!isBlogPost && <span>Reference</span>}
		</p>
	)}
	<h1 id="_top">{cat && <span class="post-category" role="img" aria-label={`${cat.label}: `} title={cat.label}>{cat.emoji}</span>}{title}</h1>
	{subtitle && <p class="page-subtitle">{subtitle}</p>}
</div>

<style>
	@layer starlight.core {
		h1 {
			margin-top: 1rem;
			font-size: var(--sl-text-h1);
			line-height: var(--sl-line-height-headings);
			font-weight: 600;
			color: var(--sl-color-white);
		}
	}

	/* Title on the top row; the project kicker and the subtitle take full-width rows. */
	.kz-page-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		column-gap: 1rem;
	}
	.kz-page-head h1 {
		flex: 1 1 auto;
		min-width: 0;
	}
	.kz-page-head .page-subtitle {
		flex: 1 0 100%;
		margin-top: 0.4rem;
		margin-bottom: 0;
		font-size: var(--sl-text-2xl);
		font-weight: 400;
		line-height: var(--sl-line-height-headings);
		color: var(--sl-color-gray-3);
	}

	.kz-page-project {
		flex: 1 0 100%;
		margin: 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.kz-page-project a {
		color: var(--sl-color-text-accent);
		text-decoration: none;
	}
	.kz-page-project a:hover {
		text-decoration: underline;
	}

	.post-category {
		/* Match the title's size (not shrunk), with a clear gap before it. */
		margin-right: 0.35em;
		vertical-align: 0.02em;
	}

</style>
