---
/**
 * <SnippetScript /> — the one delegated click handler that drives every snippet
 * surface on a page: opening a <SnippetLink> modal, the Copy button (in the
 * modal, the inline figure, and the full-page view), Close, backdrop-click,
 * and tap-to-reveal Copy on touch screens in snippets and code blocks.
 *
 * It lives in its own component so the modal (SnippetLink) and the full-page
 * viewer route can both pull in identical behavior without duplicating the
 * script. Astro bundles it once even if rendered multiple times.
 */
---

<script>
  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;

    // Open: clone the template's dialog into <body>, then showModal() (centers it).
    const opener = target.closest<HTMLElement>("[data-snippet-open]");
    if (opener) {
      const tpl = document.querySelector<HTMLTemplateElement>(
        `template[data-snippet-tpl="${opener.getAttribute("data-snippet-open")}"]`,
      );
      const node = tpl?.content.firstElementChild?.cloneNode(true);
      if (node instanceof HTMLDialogElement && typeof node.showModal === "function") {
        event.preventDefault();
        document.body.appendChild(node);
        node.addEventListener("close", () => node.remove());
        node.showModal();
      }
      return;
    }

    // Copy: the highlighted <pre>'s textContent is the original source.
    const copyBtn = target.closest<HTMLButtonElement>("[data-snippet-copy]");
    if (copyBtn) {
      const pre = copyBtn.closest(".snippet")?.querySelector(".snippet-code pre");
      if (pre && navigator.clipboard) {
        navigator.clipboard.writeText(pre.textContent ?? "").then(() => {
          copyBtn.classList.add("is-copied");
          copyBtn.setAttribute("aria-label", "Copied");
          window.setTimeout(() => {
            copyBtn.classList.remove("is-copied");
            copyBtn.setAttribute("aria-label", "Copy to clipboard");
          }, 1500);
        });
      }
      return;
    }

    const code = target.closest<HTMLElement>(
      ".expressive-code .frame pre, .snippet .snippet-code",
    );
    if (code && window.matchMedia("(hover: none)").matches && !target.closest("a, button")) {
      const frame = code.closest<HTMLElement>(".frame, .snippet");
      if (frame?.querySelector(".copy button, [data-snippet-copy]")) {
        const reveal = !frame.hasAttribute("data-copy-revealed");
        document.querySelectorAll<HTMLElement>("[data-copy-revealed]").forEach((other) => {
          other.removeAttribute("data-copy-revealed");
          other.querySelector<HTMLButtonElement>(".copy button, [data-snippet-copy]")?.blur();
        });
        if (reveal) frame.setAttribute("data-copy-revealed", "");
      }
      return;
    }

    if (target.closest("[data-snippet-close]")) {
      target.closest("dialog")?.close();
      return;
    }

    // Click on the backdrop (the dialog element itself) closes it.
    if (target instanceof HTMLDialogElement && target.classList.contains("snippet-dialog")) {
      target.close();
    }
  });
</script>
