---
/**
 * Sidebar override: one authoritative menu on every page, plus the blog's own
 * post navigation kept intact on /blog/ pages, and a global RSS link pinned to
 * the very bottom.
 *
 * starlight-blog's route middleware builds a dynamic blog sidebar (All posts,
 * Recent posts with the current post highlighted, Tags with counts, RSS, ...),
 * and Starlight's middleware ordering means a user route middleware can't
 * reliably run after it. So here, after it has already run, we merge:
 *   - outside the blog: the authoritative menu (About, [Projects,] Blog);
 *   - inside the blog: the authoritative menu with its global "Blog" link
 *     dropped, because the blog's own "All posts" (relabeled "Blog", kept
 *     current for the whole section) stands in for it, followed by Recent posts
 *     and Tags. The single-author Authors group is dropped.
 * A single global RSS link is then appended last on every page (replacing
 * starlight-blog's own RSS entry, which we drop to avoid a duplicate). Finally
 * we render Starlight's stock Sidebar, so markup, styling, scroll persistence,
 * the mobile menu, and the current-post highlight stay native.
 */
import Default from "@astrojs/starlight/components/Sidebar.astro";
import { buildSidebar } from "../lib/sidebar.mjs";
import { listSidebarProjects } from "../lib/projects.mjs";
import { countBlogPosts, listAllSeries } from "../lib/series.mjs";
import { BLOG_POST_COUNT, RECENT_POST_COUNT } from "../consts";

const route = Astro.locals.starlightRoute;
const pathname = Astro.url.pathname;
const onBlog = pathname === "/blog/" || pathname.startsWith("/blog/");
const onProjects = pathname === "/projects/" || pathname.startsWith("/projects/");

const isBlogRoot = (e) => e.type === "link" && /\/blog\/?$/.test(e.href);
const isProjectsRoot = (e) => e.type === "link" && /\/projects\/?$/.test(e.href);
const isRss = (e) => e.type === "link" && /rss\.xml$/.test(e.href);

// Global RSS link, pinned to the very bottom of the menu on every page (so it
// shows even outside the blog); replaces starlight-blog's own RSS entry.
const RSS = {
  type: "link",
  label: "RSS",
  href: "/blog/rss.xml",
  isCurrent: false,
  badge: undefined,
  attrs: { target: "_blank", "data-icon": "rss" },
};

// Keep the blog post navigation (All posts, Recent/Featured, Tags); drop the
// single-author Authors group and the RSS link (we pin our own RSS below).
function blogPostNav(entries) {
  const isAuthorsGroup = (e) =>
    e.type === "group" &&
    e.entries.length > 0 &&
    e.entries.every((x) => x.type === "link" && /\/blog\/authors\//.test(x.href));
  return entries.filter((e) => !isAuthorsGroup(e) && !isRss(e));
}

let menu = buildSidebar(pathname);
let extras = [];
if (onBlog) {
  // Drop the global "Blog" link; the blog's own "All posts" takes its place,
  // relabeled "Blog" and lit for the whole blog section.
  menu = menu.filter((e) => !isBlogRoot(e));
  // "Recent posts" is capped at RECENT_POST_COUNT; if there are more posts, append a
  // "View more" link that jumps to the /blog/ page continuing right after the recent list
  // (page floor(RECENT / POST) + 1 — no overlap, since RECENT is a multiple of POST).
  const recentLabel = Astro.locals.t("starlightBlog.sidebar.recent");
  const totalPosts = await countBlogPosts();
  const showViewMore = totalPosts > RECENT_POST_COUNT;
  const morePage = Math.floor(RECENT_POST_COUNT / BLOG_POST_COUNT) + 1;
  const viewMore = {
    type: "link",
    label: "View more\u2026",
    href: `/blog/${morePage}/`,
    isCurrent: false,
    badge: undefined,
    attrs: { "data-view-more": "" },
  };
  const isRecentGroup = (e) => e.type === "group" && e.label === recentLabel;
  extras = blogPostNav(route.sidebar).map((e) => {
    if (isBlogRoot(e)) {
      return { ...e, label: "Blog", isCurrent: true, attrs: { ...(e.attrs ?? {}), "data-icon": "open-book" } };
    }
    if (showViewMore && isRecentGroup(e)) {
      return { ...e, entries: [...e.entries, viewMore] };
    }
    return e;
  });
  // A "Series" group listing the article series, placed right after "Featured posts"
  // (falling back to right under "Blog" when there is no featured group). Each entry
  // links to a series' first part; the current series is lit. The list is capped at
  // SERIES_SIDEBAR_COUNT, and only when it overflows does a trailing "All series…" link
  // appear, jumping to /blog/series/ (mirrors how "Recent posts" appends "View more…").
  const SERIES_SIDEBAR_COUNT = 10;
  const featuredLabel = Astro.locals.t("starlightBlog.sidebar.featured");
  const currentBlogSlug = pathname.replace(/^\/blog\//, "").replace(/\/$/, "") || null;
  const allSeries = await listAllSeries(currentBlogSlug);
  if (allSeries.length > 0) {
    const onSeriesIndex = pathname.startsWith("/blog/series");
    const seriesEntries = allSeries.slice(0, SERIES_SIDEBAR_COUNT).map((s) => ({
      type: "link",
      label: s.name,
      href: `/blog/${s.landingSlug}/`,
      isCurrent: s.isCurrent && !onSeriesIndex,
      badge: undefined,
      attrs: { "data-subnav": "" },
    }));
    if (allSeries.length > SERIES_SIDEBAR_COUNT) {
      seriesEntries.push({
        type: "link",
        label: "All series\u2026",
        href: "/blog/series/",
        isCurrent: onSeriesIndex,
        badge: undefined,
        attrs: { "data-view-more": "" },
      });
    }
    const seriesGroup = {
      type: "group",
      label: "Series",
      collapsed: false,
      badge: undefined,
      entries: seriesEntries,
    };
    // After "Featured posts" when it exists; otherwise right under "Blog".
    const featAt = extras.findIndex((e) => e.type === "group" && e.label === featuredLabel);
    if (featAt >= 0) {
      extras.splice(featAt + 1, 0, seriesGroup);
    } else {
      const at = extras.findIndex(isBlogRoot);
      if (at >= 0) extras.splice(at + 1, 0, seriesGroup);
      else extras.unshift(seriesGroup);
    }
  }
} else if (onProjects) {
  // Expand the "Projects" entry in place: keep it as the (current) section link, then list
  // the featured + active projects right under it, the current one lit. Mirrors how the
  // blog expands its posts, but inserted in place so menu order (About, Projects, Blog) holds.
  const slug = pathname.replace(/^\/projects\//, "").replace(/\/$/, "");
  const projects = await listSidebarProjects(slug);
  const sublinks = projects.map((p) => ({
    type: "link",
    label: p.name,
    href: `/projects/${p.landingSlug}/`,
    isCurrent: p.isCurrent,
    badge: undefined,
    attrs: { "data-subnav": "" },
  }));
  menu = menu.flatMap((e) =>
    isProjectsRoot(e) ? [{ ...e, isCurrent: true }, ...sublinks] : [e],
  );
}
route.sidebar = [...menu, ...extras, RSS];
---

<Default />
